{
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],  
    "routes": [
        {
            "src":"/(.*)",
            "dest":"main.py"
        }
    ],
    {
      "crons": [
        {
          "path": "/cron/simulate",
          "schedule": "0 0 * * *"
        }
      ]
    }
}
